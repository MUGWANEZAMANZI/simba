UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_APP_NAME=simba-supermarket
UNSPLASH_DELAY_MS=450

# Hugging Face token used for:
#   - the Qwen rerank step in /api/search (semantic product search)
#   - the Aya recommendation flow in the storefront
# If unset, the search still works on local sentence-transformer embeddings.
VITE_HF_TOKEN=
VITE_HF_MODEL=CohereLabs/aya-expanse-8b

# Model used to rerank semantic search results with a Qwen chat model on
# Hugging Face's OpenAI-compatible router. Override if you prefer a smaller
# Qwen checkpoint (e.g. Qwen/Qwen2.5-7B-Instruct).
QWEN_MODEL=Qwen/Qwen2.5-72B-Instruct

# Ollama configuration for local embeddings.
# Set OLLAMA_HOST if your Ollama instance is not at http://localhost:11434.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Authentication & Email Configuration
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-app-password
# JWT_SECRET=a-secure-random-string
